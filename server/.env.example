# ─── Ambiente ────────────────────────────────────────────────────────────────
# 'development' e 'test' sono gli UNICI valori che attivano le scorciatoie di
# sviluppo (pagamenti simulati, risposte AI simulate, segreto JWT di default).
# Qualsiasi altro valore — compreso NODE_ENV non impostato — viene trattato
# come produzione, e il server rifiuta di partire senza segreti reali.
# ATTENZIONE: non distribuire in produzione un .env che contenga development.
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/your-character

# ─── Autenticazione ──────────────────────────────────────────────────────────
# In produzione deve essere un valore casuale di almeno 32 caratteri, diverso
# da quello qui sotto. Cambiarlo invalida tutte le sessioni esistenti.
JWT_SECRET=your_character_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# ─── Motore conversazionale ──────────────────────────────────────────────────
# Senza una chiave valida l'app entra in modalità degradata: risponde con testo
# dichiaratamente simulato e NON addebita crediti. In produzione non parte.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Forza la modalità del motore AI (normalmente si deduce dalle chiavi):
#   live     → API reali, credito addebitato
#   stub     → risposte deterministiche per i test, credito addebitato
#   degraded → risposte simulate ed etichettate, nessun addebito
#   fail     → guasto simulato (solo test)
#   unsafe   → risposta deliberatamente vietata, per verificare la moderazione
#              dell'output (solo test)
# In produzione la variabile viene ignorata: nessuna modalità forzata è
# raggiungibile su un ambiente pubblico.
# AI_MODE=degraded

# ─── Generazione immagini ────────────────────────────────────────────────────
STABILITY_API_KEY=your_stability_api_key_here

# ─── Pagamenti ───────────────────────────────────────────────────────────────
# Con una chiave segnaposto i pagamenti sono simulati e disponibili SOLO fuori
# produzione. Il webhook richiede SEMPRE una firma valida, in ogni ambiente.
STRIPE_SECRET_KEY=sk_test_stripe_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
# ID dei prezzi ricorrenti Stripe, necessari per gli abbonamenti reali:
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_ANNUAL=price_...

# ─── Autenticazione esterna (opzionale) ──────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_sample
CLERK_SECRET_KEY=sk_test_sample


# ─── Moderazione (FASE D) ────────────────────────────────────────────────────
# Account che ricevono il ruolo di amministratore al primo accesso. Serve a far
# nascere il PRIMO moderatore: senza, la coda di revisione resterebbe
# inaccessibile a chiunque. Gli altri ruoli si assegnano con:
#   node scripts/grantRole.js utente@example.com moderator
# ADMIN_EMAILS=titolare@example.com

# ─── Dati fiscali del venditore (FASE D — ricevute e IVA) ────────────────────
# Finché non sono compilati, le ricevute vengono emesse dichiarandosi
# provvisorie invece di esibire un'intestazione inventata.
# SELLER_NAME=Ragione Sociale S.r.l.
# SELLER_VAT_NUMBER=IT01234567890
# SELLER_ADDRESS=Via Esempio 1, 20100 Milano (MI), Italia
# SELLER_COUNTRY=IT
# SELLER_OSS_REGISTERED=true
