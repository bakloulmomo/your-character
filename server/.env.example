# ─── Ambiente ────────────────────────────────────────────────────────────────
# 'development' e 'test' sono gli UNICI valori che attivano le scorciatoie di
# sviluppo (pagamenti simulati, risposte AI simulate, segreto JWT di default).
# Qualsiasi altro valore — compreso NODE_ENV non impostato — viene trattato
# come produzione, e il server rifiuta di partire senza segreti reali.
# ATTENZIONE: non distribuire in produzione un .env che contenga development.
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/your-character

# ─── Autenticazione ──────────────────────────────────────────────────────────
# In produzione deve essere un valore casuale di almeno 32 caratteri, diverso
# da quello qui sotto. Cambiarlo invalida tutte le sessioni esistenti.
JWT_SECRET=your_character_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# ─── Motore conversazionale ──────────────────────────────────────────────────
# Senza una chiave valida l'app entra in modalità degradata: risponde con testo
# dichiaratamente simulato e NON addebita crediti. In produzione non parte.
GEMINI_API_KEY=your_gemini_api_key_here
# Per la beta gratuita: gemini-2.5-flash-lite.
# Il piano gratuito concede 1.000 richieste al giorno con flash-lite contro le
# 250 di flash — quattro volte tanto, sulla stessa chiave e senza carta di
# credito. ATTENZIONE: attivare la fatturazione sul progetto Google fa sparire
# il piano gratuito per sempre su quel progetto, anche per le chiamate che ci
# sarebbero rientrate. Non attivarla finche' non serve davvero.
GEMINI_MODEL=gemini-3.5-flash-lite

# Forza la modalità del motore AI (normalmente si deduce dalle chiavi):
#   live     → API reali, credito addebitato
#   stub     → risposte deterministiche per i test, credito addebitato
#   degraded → risposte simulate ed etichettate, nessun addebito
#   fail     → guasto simulato (solo test)
#   unsafe   → risposta deliberatamente vietata, per verificare la moderazione
#              dell'output (solo test)
# In produzione la variabile viene ignorata: nessuna modalità forzata è
# raggiungibile su un ambiente pubblico.
# AI_MODE=degraded

# ─── Generazione immagini ────────────────────────────────────────────────────
STABILITY_API_KEY=your_stability_api_key_here

# ─── Pagamenti ───────────────────────────────────────────────────────────────
# Con una chiave segnaposto i pagamenti sono simulati e disponibili SOLO fuori
# produzione. Il webhook richiede SEMPRE una firma valida, in ogni ambiente.
STRIPE_SECRET_KEY=sk_test_stripe_sample
STRIPE_WEBHOOK_SECRET=whsec_sample
# ID dei prezzi ricorrenti Stripe, necessari per gli abbonamenti reali:
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_ANNUAL=price_...

# ─── Autenticazione esterna (opzionale) ──────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_sample
CLERK_SECRET_KEY=sk_test_sample


# ─── Moderazione (FASE D) ────────────────────────────────────────────────────
# Account che ricevono il ruolo di amministratore al primo accesso. Serve a far
# nascere il PRIMO moderatore: senza, la coda di revisione resterebbe
# inaccessibile a chiunque. Gli altri ruoli si assegnano con:
#   node scripts/grantRole.js utente@example.com moderator
# ADMIN_EMAILS=titolare@example.com

# ─── Dati fiscali del venditore (FASE D — ricevute e IVA) ────────────────────
# Finché non sono compilati, le ricevute vengono emesse dichiarandosi
# provvisorie invece di esibire un'intestazione inventata.
# SELLER_NAME=Ragione Sociale S.r.l.
# SELLER_VAT_NUMBER=IT01234567890
# SELLER_ADDRESS=Via Esempio 1, 20100 Milano (MI), Italia
# SELLER_COUNTRY=IT
# SELLER_OSS_REGISTERED=true

# ─── Beta chiusa e gratuita ──────────────────────────────────────────────────
# Tutti gli interruttori sono SPENTI per difetto: una variabile dimenticata
# lascia la funzione spenta, mai accesa.
# FEATURE_PAYMENTS=false
# FEATURE_SUBSCRIPTIONS=false
# FEATURE_IMAGE_GENERATION=false

# Crediti regalati a chi si iscrive. Con i pagamenti spenti il default e' 100:
# dieci sarebbero dieci messaggi e nessun modo di proseguire.
# WELCOME_CREDITS=100

# Codice d'invito. Se impostato, la registrazione lo richiede: e' cio' che
# rende chiusa una beta chiusa.
# BETA_INVITE_CODE=AMICI-2026

# Tetto giornaliero di messaggi per utente.
# NON e' una leva commerciale: protegge la quota GRATUITA di Gemini, che vale
# per l'intero progetto e non per utente. Senza, una sola persona presa dalla
# conversazione la esaurirebbe per tutti entro mezzogiorno.
# Con gemini-2.5-flash-lite (1.000 richieste/giorno gratis) e 40 invitati,
# un tetto di 25 lascia margine.
# BETA_DAILY_MESSAGE_CAP=25

# Dove arrivano le opinioni degli utenti. Se non impostato, si usa il primo
# indirizzo di ADMIN_EMAILS.
# FEEDBACK_EMAIL=tu@example.com

# ─── POSTA ────────────────────────────────────────────────────────────────
# Senza un trasporto configurato il prodotto non e' utilizzabile: i codici di
# conferma non partono, e senza conferma non si inviano messaggi, non si creano
# personaggi e non si compra nulla. Il recupero password tace, e le opinioni
# restano in database senza che nessuno le legga.
#
# Si sceglie UNO dei due. Se c'e' RESEND_API_KEY vince Resend.
#
# A) Resend — la scelta a regime. Richiede un dominio verificato (SPF + DKIM).
#    Piano gratuito: 3.000 email al mese.
# RESEND_API_KEY=re_...
#
# B) SMTP — il ripiego quando il dominio non c'e' ancora.
#    Con Gmail serve la 2FA attiva e una "password per le app"
#    (myaccount.google.com → Sicurezza → Password per le app), MAI la password
#    normale dell'account.
#    Limiti reali: il mittente e' il tuo indirizzo personale, il tetto e' di
#    qualche centinaio di messaggi al giorno, e senza SPF/DKIM allineati una
#    parte dei codici finisce nella posta indesiderata — cioe' proprio dove
#    l'utente non li cerca. Va bene per una beta, non per la crescita.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
#
# Mittente mostrato. Default: SMTP_USER, oppure no-reply@your-character.app.
# MAIL_FROM=no-reply@tuo-dominio.it

# Dimensione del pool di connessioni verso MongoDB. E' un budget CONDIVISO fra
# le istanze dell'applicazione, non un valore per processo: alla seconda
# istanza va dimezzato.
# MONGO_MAX_POOL_SIZE=20
