# Chiave PUBBLICABILE di Stripe (pk_test_... o pk_live_...).
# È pubblica per definizione: identifica l'account e non autorizza pagamenti da sola.
# Se non è impostata, l'interfaccia non offre il pagamento con carta invece di fingere che funzioni.
VITE_STRIPE_PUBLISHABLE_KEY=

# Raccolta degli errori (opzionale).
# Senza questo valore l'SDK di Sentry viene ELIMINATO dal pacchetto in fase di
# build: 444 KB invece di 532. Con un valore, `connect-src` della CSP deve
# consentire l'invio — vercel.json e public/_headers includono ora
# https://*.ingest.sentry.io, che prima mancava: gli invii venivano bloccati
# dal browser, in silenzio, e la raccolta sembrava configurata senza esserlo.
VITE_SENTRY_DSN=

# Etichetta della versione associata agli errori raccolti. Tipicamente lo SHA
# del commit, impostato dal sistema di build.
VITE_APP_RELEASE=
