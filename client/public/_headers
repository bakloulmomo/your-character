# Intestazioni di sicurezza per hosting statico compatibile Netlify.
# Duplicano quelle di vercel.json: la pagina deve avere la stessa policy
# ovunque venga pubblicata, altrimenti la CSP esiste solo su un hosting.
#
# 'unsafe-inline' sugli stili è necessario: React e Tailwind iniettano stili
# inline a runtime. Sugli script NON c'è, ed è lì che conta.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
